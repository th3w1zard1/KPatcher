<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NCSDecomp.UI.MainWindow"
        Title="NCSDecomp — managed KotOR script decompiler"
        Width="860" Height="600"
        MinWidth="640" MinHeight="480">
  <DockPanel Margin="0">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Name="MenuOpenNcs" Header="Open .ncs…" InputGesture="Ctrl+O" Click="OnOpenNcsClick" />
        <MenuItem Name="MenuSaveNss" Header="Save .nss…" InputGesture="Ctrl+S" Click="OnSaveNssClick" />
        <Separator />
        <MenuItem Name="MenuCopyNss" Header="Copy NSS to clipboard" InputGesture="Ctrl+Shift+C" Click="OnCopyNssClick" />
        <Separator />
        <MenuItem Header="E_xit" InputGesture="Alt+F4" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Decompile">
        <MenuItem Name="MenuDecompile" Header="Decompile loaded .ncs" InputGesture="F5" Click="OnDecompileClick" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Name="MenuRoundTrip" Header="Managed round-trip check" Click="OnRoundTripClick" />
        <MenuItem Name="MenuOpenConfig" Header="Open config folder" Click="OnOpenConfigFolderClick" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About NCSDecomp" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Padding="12,8,12,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="OpenNcsButton" Content="Open .ncs…" MinWidth="96" />
          <TextBlock Name="NcsPathText" VerticalAlignment="Center" Text="No file loaded"
                     TextTrimming="CharacterEllipsis" MaxWidth="420" Opacity="0.85" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Game:" VerticalAlignment="Center" />
          <ComboBox Name="GameCombo" Width="150" SelectedIndex="0">
            <ComboBoxItem Content="KotOR 1" />
            <ComboBoxItem Content="KotOR 2 (TSL)" />
          </ComboBox>
          <Button Name="DecompileButton" Content="Decompile" MinWidth="96" Classes="accent" />
          <Button Name="SaveNssButton" Content="Save .nss…" MinWidth="96" />
          <Button Name="CopyNssButton" Content="Copy NSS" MinWidth="88" ToolTip.Tip="Copy Plain text tab to clipboard" />
          <Button Name="RoundTripButton" Content="Round-trip" MinWidth="96"
                  ToolTip.Tip="Recompile NSS with KCompiler and compare decoder output to the loaded .ncs" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="11"
                   Text="Managed NCS→NSS (NCSDecomp.Core + KCompiler). Settings: config/ncsdecomp.conf beside the app. Drag and drop a .ncs file onto this window." />
        <ProgressBar Name="BusyBar" IsIndeterminate="True" IsVisible="False" Height="4" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,8,12,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
      <TextBlock Name="StatusText" TextWrapping="Wrap" Opacity="0.9" Text="Ready — open a .ncs file to begin." />
    </Border>

    <TabControl Name="MainTabs" Margin="12,0,12,0" SelectionChanged="OnMainTabsSelectionChanged">
      <TabItem Header="Highlighted NSS">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock Name="NssHighlighted"
                               FontFamily="Consolas,Courier New,monospace" FontSize="12"
                               TextWrapping="Wrap" />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Plain text">
        <TextBox Name="NssOutputPlain" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas,Courier New,monospace" FontSize="12"
                 Watermark="Decompiled NSS appears here. You can edit before saving or round-trip."
                 TextChanged="OnNssPlainTextChanged" />
      </TabItem>
      <TabItem Header="Bytecode">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock Name="NssBytecodeView"
                               FontFamily="Consolas,Courier New,monospace" FontSize="12"
                               TextWrapping="Wrap" />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="AST">
        <TreeView Name="AstTree" FontFamily="Consolas,Courier New,monospace" FontSize="11" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
